# Copie para .env. Não compartilhe .env nem o envie ao GitHub.
DB_HOST=127.0.0.1
DB_NAME=classmanager
# Configuração padrão do MySQL no XAMPP: usuário root e senha vazia.
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
APP_ORIGIN=http://localhost

# Opcional: necessário somente para recuperação de senha por e-mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NOME=ClassManager
